{
  "name": "work-task-for-our-work-sprint",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:ci": "npx playwright test --reporter=html,junit,json",
    "test:parallel": "npx playwright test --workers=4",
    "test:prod": "cross-env TEST_ENV=production npx playwright test",
    "test:qa": "cross-env TEST_ENV=qa npx playwright test",
    "test:dev": "cross-env TEST_ENV=dev npx playwright test"
  },
  "repository": {
